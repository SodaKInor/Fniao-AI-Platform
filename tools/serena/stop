#!/bin/zsh
set -eu

script_dir="${0:A:h}"
source "$script_dir/_common"

if ! screen -ls 2>/dev/null | grep -Eq "[.]${screen_session}[[:space:]]" && \
   ! launchctl print "gui/$(id -u)/$legacy_launch_label" >/dev/null 2>&1 && \
   ! lsof -nP -iTCP:"$mcp_port" -sTCP:LISTEN >/dev/null 2>&1; then
  print "Serena is already stopped for $repo_root"
  exit 0
fi

screen -S "$screen_session" -X quit >/dev/null 2>&1 || true
launchctl remove "$legacy_launch_label" >/dev/null 2>&1 || true
listener_pids="$(lsof -nP -iTCP:"$mcp_port" -sTCP:LISTEN -t 2>/dev/null || true)"
if [ -n "$listener_pids" ]; then
  print -r -- "$listener_pids" | while IFS= read -r listener_pid; do
    kill -TERM "$listener_pid" 2>/dev/null || true
  done
fi
for attempt in $(seq 1 35); do
  if ! screen -ls 2>/dev/null | grep -Eq "[.]${screen_session}[[:space:]]" && \
     ! lsof -nP -iTCP:"$mcp_port" -sTCP:LISTEN >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
print "Stopped Serena for $repo_root"
