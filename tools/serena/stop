#!/bin/zsh
set -eu

label="com.local.wgai-serena"
domain="gui/$(id -u)"
fallback_pid_file="/Users/twowt88/Documents/ChatGPT/WGAI/.serena/runtime/fallback.pid"
stopped=false

if launchctl print "$domain/$label" >/dev/null 2>&1; then
  launchctl bootout "$domain/$label"
  print "Stopped $label"
  stopped=true
fi

if [ -r "$fallback_pid_file" ]; then
  fallback_pid="$(<"$fallback_pid_file")"
  if kill -0 "$fallback_pid" 2>/dev/null; then
    kill -TERM "$fallback_pid"
    for attempt in $(seq 1 35); do
      kill -0 "$fallback_pid" 2>/dev/null || break
      sleep 1
    done
    if kill -0 "$fallback_pid" 2>/dev/null; then
      command_line="$(ps -p "$fallback_pid" -o command= 2>/dev/null || true)"
      if [[ "$command_line" == *"wgai-serena-service"* ]]; then
        kill -KILL "$fallback_pid" 2>/dev/null || true
      fi
    fi
    print "Stopped Serena fallback process (PID $fallback_pid)"
    stopped=true
  fi
  rm -f "$fallback_pid_file"
fi

if [ "$stopped" = false ]; then
  print "$label is already stopped"
fi
