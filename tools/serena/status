#!/bin/zsh
set -u

script_dir="${0:A:h}"
source "$script_dir/_common"

if screen -ls 2>/dev/null | grep -Eq "[.]${screen_session}[[:space:]]"; then
  serena_pid="$(lsof -nP -iTCP:"$mcp_port" -sTCP:LISTEN -t 2>/dev/null | head -n 1 || true)"
  if [ -n "$serena_pid" ]; then
    print "Process: running for $repo_root (PID $serena_pid)"
  else
    print "Process: screen session warming up for $repo_root"
  fi
else
  print "Process: stopped for $repo_root"
fi

if lsof -nP -iTCP:"$mcp_port" -sTCP:LISTEN 2>/dev/null | grep -q '127.0.0.1'; then
  print "MCP: listening at http://127.0.0.1:${mcp_port}/mcp"
else
  print "MCP: not listening on 127.0.0.1:${mcp_port}"
fi

dashboard_url="$(grep -Eho 'http://127\.0\.0\.1:[0-9]+/dashboard[^[:space:]]*' "$stdout_log" "$stderr_log" 2>/dev/null | tail -n 1 || true)"
[ -n "$dashboard_url" ] && print "Dashboard: $dashboard_url" || print "Dashboard: waiting for Serena startup log"
