#!/bin/zsh
set -eu

script_dir="${0:A:h}"
repo_root="$(git -C "$script_dir" rev-parse --show-toplevel)"
runtime_dir="$repo_root/.serena/runtime"
stdout_log="$runtime_dir/serena.stdout.log"
stderr_log="$runtime_dir/serena.stderr.log"
serena_bin="$(command -v serena)"
node_bin_dir="${$(command -v node):h}"
mcp_port="${SERENA_MCP_PORT:-9121}"
screen_session="fniao-ai-platform-serena"
legacy_launch_label="com.local.fniao-ai-platform-serena"
