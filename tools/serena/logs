#!/bin/zsh
set -eu

script_dir="${0:A:h}"
source "$script_dir/_common"

if [ "${1:-}" = "-f" ]; then
  touch "$stdout_log" "$stderr_log"
  exec tail -F "$stdout_log" "$stderr_log"
fi

lines="${1:-80}"
print "==> $stdout_log <=="
tail -n "$lines" "$stdout_log" 2>/dev/null || true
print "==> $stderr_log <=="
tail -n "$lines" "$stderr_log" 2>/dev/null || true
