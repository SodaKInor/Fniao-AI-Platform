#!/bin/zsh
set -eu

script_dir="${0:A:h}"
source "$script_dir/_common"
mkdir -p "$runtime_dir"
launch_runner="$HOME/.local/bin/fniao-serena-service"
mkdir -p "${launch_runner:h}"
install -m 755 "$script_dir/launch" "$launch_runner"

if screen -ls 2>/dev/null | grep -Eq "[.]${screen_session}[[:space:]]"; then
  print "Serena screen session is already registered for $repo_root."
  exec "$script_dir/status"
fi

launchctl remove "$legacy_launch_label" >/dev/null 2>&1 || true
: > "$stdout_log"
: > "$stderr_log"
cd "$repo_root"
screen -DmS "$screen_session" \
  "$launch_runner" "$serena_bin" "$repo_root" "$mcp_port" "$HOME" "$stdout_log" "$stderr_log" "$node_bin_dir" \
  >/dev/null 2>&1 &

for attempt in $(seq 1 60); do
  if lsof -nP -iTCP:"$mcp_port" -sTCP:LISTEN 2>/dev/null | grep -q '127.0.0.1'; then
    exec "$script_dir/status"
  fi
  if ! screen -ls 2>/dev/null | grep -Eq "[.]${screen_session}[[:space:]]"; then
    break
  fi
  sleep 1
done

print -u2 "Serena failed to start. Inspect tools/serena/logs."
exit 1
