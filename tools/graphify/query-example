#!/bin/zsh
set -eu

script_dir="${0:A:h}"
repo_root="$(git -C "$script_dir" rev-parse --show-toplevel)"
graphify_bin="$(command -v graphify)"
cd "$repo_root"

print "== 中文查询 =="
"$graphify_bin" query "帮我梳理后端启动入口、前端 API 调用入口、数据库初始化脚本与核心模块关系"
print "== Equivalent English query =="
"$graphify_bin" query "backend startup entry frontend API call entry database initialization scripts and core module relationships"
