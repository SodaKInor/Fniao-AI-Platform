#!/bin/zsh
set -eu

workspace="/Users/twowt88/Documents/ChatGPT/WGAI"
cd "$workspace"

result=0
output="$(/Users/twowt88/.local/bin/graphify update "$workspace" 2>&1)" || result=$?
print -r -- "$output"

if [ "$result" -eq 0 ]; then
  exit 0
fi

if [[ "$output" == *"Nothing to update"* ]] && [ -s "$workspace/graphify-out/graph.json" ]; then
  print "Graphify graph is already up to date."
  exit 0
fi

exit "$result"
