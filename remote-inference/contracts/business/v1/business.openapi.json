                }
              }
            }
          },
          "415": {
            "description": "不支持的媒体类型",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "队列/用户限额，未创建新任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "业务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "有归属的资产已到期；不得回源重新推理",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ExistingLogin": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Token",
        "description": "复用当前登录令牌；不新增登录接口。GPU 鉴权失败映射为 PROVIDER_AUTH，不能返回业务 401。"
      }
    },
    "schemas": {
      "JobState": {
        "type": "string",
