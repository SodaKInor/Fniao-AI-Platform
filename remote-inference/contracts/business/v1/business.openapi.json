            "description": "业务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "202": {
            "description": "后台继续原调用；Location 为本地任务路径，Retry-After 为建议轮询秒数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "/jeecg-boot/ai/v1/jobs/{requestId}"
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "建议初始 2 秒；不授权重新提交"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            "description": "当前用户范围；与规范化请求摘要原子去重；同 key 不同摘要返回 409。"
          },
          {
            "in": "query",
            "name": "waitMillis",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1500,
              "default": 1500
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InferenceRequestDto"
              }
            }
          }
        }
      }
    },
