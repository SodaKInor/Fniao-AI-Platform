            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "height": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "description": "归一化矩形；x+width <= 1 且 y+height <= 1，由应用校验。"
      },
      "DetectionDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "box": {
            "$ref": "#/components/schemas/BoundingBoxDto"
          }
        },
        "required": [
          "label",
          "score",
          "box"
        ]
      },
      "DetectionDataDto": {
        "type": "object",
        "additionalProperties": false,
