              "INVALID_REQUEST",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "ASSET_EXPIRED",
              "LIMIT_EXCEEDED",
              "UNSUPPORTED_MEDIA",
