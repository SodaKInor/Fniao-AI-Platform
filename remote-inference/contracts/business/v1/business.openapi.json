        "description": "安全业务错误；requestId 是已保存的本地任务，可为空。禁止供应商响应、内部 URL、密钥或栈信息。"
      },
      "JobDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
