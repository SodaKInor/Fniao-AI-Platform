            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "retryOfRequestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
