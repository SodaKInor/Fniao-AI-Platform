          "imageWidth",
          "imageHeight",
          "detections"
        ]
      },
      "AssetDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "assetId",
          "fileName",
          "mediaType",
          "sizeBytes",
          "sha256",
          "createdAt",
          "expiresAt"
        ],
        "description": "业务私有资产元数据；无绝对路径、存储键、外部 URL 或用户凭据。到期返回 410；缺失或无归属返回 404。"
      },
      "InferenceResultDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "simulated": {
            "type": "boolean"
          },
