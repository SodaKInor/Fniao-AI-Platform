          "inputAssetId",
          "parameters"
        ],
        "description": "固定首个文件能力；retryOfRequestId 仅用于用户明确发起的新尝试，需新 Idempotency-Key。不得自动填入。"
      },
      "BoundingBoxDto": {
        "type": "object",
