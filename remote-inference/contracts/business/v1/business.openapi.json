          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetDto"
            },
            "maxItems": 1
          }
        },
        "required": [
          "simulated",
          "data",
          "artifacts"
        ],
        "description": "data.detections=[] 且 artifacts=[] 是有效空成果。所有文件已完整回存后才出现在成功结果。"
      },
      "ErrorDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "errorCode": {
            "type": "string",
