    "/assets/{id}/content": {
      "get": {
        "operationId": "downloadAsset",
        "summary": "授权后下载完整私有资产",
        "responses": {
          "200": {
            "description": "二进制流，不使用 Result 包装；Content-Disposition: attachment，nosniff，Cache-Control: private, no-store。首期不承诺 Range。",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "nosniff"
                  ]
                }
              }
            },
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "参数非法",
            "content": {
