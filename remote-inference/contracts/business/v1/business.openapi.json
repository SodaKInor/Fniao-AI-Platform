          "PENDING",
          "DISPATCHING",
          "WAITING",
          "FETCHING_RESULT",
          "SUCCEEDED",
          "FAILED",
          "UNKNOWN",
          "CANCELLED"
        ]
      },
      "DetectionParametersDto": {
        "type": "object",
        "additionalProperties": false,
