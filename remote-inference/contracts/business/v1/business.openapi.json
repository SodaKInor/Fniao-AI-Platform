        "required": [
          "requestId",
          "capabilityCode",
          "capabilityVersion",
          "inputAssetId",
          "parameters",
          "state",
          "simulated",
          "createdAt",
          "updatedAt"
        ],
        "description": "result 只在 SUCCEEDED 存在；FAILED/UNKNOWN 必须有 error；FETCHING_RESULT 可含传输错误，不能有成功 result。可选字段省略，不发送 null 的 result/error。"
      },
      "CapabilityDto": {
        "type": "object",
