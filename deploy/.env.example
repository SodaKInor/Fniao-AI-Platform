COMPOSE_PROJECT_NAME=fniao-ai-platform

# Project-compatible build/runtime versions. Update here, not in source files.
MAVEN_IMAGE=maven:3.8.8-eclipse-temurin-8
JAVA_IMAGE=eclipse-temurin:8-jre-jammy
NODE_IMAGE=node:16.20.2-bullseye
NGINX_IMAGE=nginx:1.26.3-alpine
MYSQL_IMAGE=mysql:8.0.36
REDIS_IMAGE=redis:7.2.7-alpine
APP_IMAGE_TAG=local

FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_INTERNAL_PORT=8080

MYSQL_DATABASE=java_ai
MYSQL_USER=wgai
MYSQL_PASSWORD=CHANGE_ME_GENERATED_BY_START_SCRIPT
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATED_BY_START_SCRIPT
REDIS_PASSWORD=CHANGE_ME_GENERATED_BY_START_SCRIPT
DATABASE_BASELINE_FILE=../database/private/java_ai.sql

# Core deployment: algorithms and hardware stay disabled.
WGAI_OPENCV_ENABLED=false
WGAI_ALGORITHM_ENABLED=false
WGAI_ASR_ENABLED=false
WGAI_CAMERA_ENABLED=false
WGAI_GPU_ENABLED=false
WGAI_PLC_ENABLED=false
OPENCV_NATIVE_PATH=
WGAI_MAXKB_HOST=
WGAI_MAXKB_APP_KEY=
WGAI_MAXKB_APP_SECRET=
WGAI_ASR_HOST=
WGAI_ASR_PORT=
WGAI_ASR_PROTOCOL=http
WGAI_CAMERA_STREAM_URL=

# Remote inference remains disabled until a confirmed real provider is supplied.
WGAI_INFERENCE_MODE=disabled
WGAI_INFERENCE_DEVELOPMENT_STUB=false
WGAI_INFERENCE_PROVIDER_KEY=remote
WGAI_INFERENCE_BASE_URL=
WGAI_INFERENCE_APPROVED_ORIGIN=
WGAI_INFERENCE_TOKEN_FILE=/run/secrets/wgai-inference-token
WGAI_INFERENCE_CA_FILE=

# Filled later when the Windows algorithm-service contract is ready.
VUE_APP_VIDEO_STREAM_URL=
